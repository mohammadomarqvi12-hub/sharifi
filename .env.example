# Copy this file to .env or configure environment variables in your hosting panel.
# Never commit real secrets to source control.
SHARIFI_SECRET_KEY=replace-with-a-long-random-secret
SHARIFI_SETUP_KEY=replace-with-a-different-long-random-one-time-setup-key
SHARIFI_DB_PATH=./sharifi.db
SHARIFI_HTTPS=0
PORT=5000
